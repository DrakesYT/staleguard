# Copy to .env and fill in.

# Tavily: https://app.tavily.com (free credits for hackathon participants)
TAVILY_API_KEY=tvly-xxxxxxxx

# Bifrost gateway. scripts\start-bifrost.ps1 passes these provider keys to Bifrost (leave unused ones empty).
BIFROST_URL=http://localhost:8080
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Models as provider/model, routed by Bifrost. Use providers you've added keys for in the Bifrost UI.
# Gemini and Groq both have free tiers.
MODEL_FAST=gemini/gemini-3.5-flash-lite
MODEL_SMART=groq/openai/gpt-oss-120b
# Bifrost tries these, in order, if the primary fails (comma-separated; the primary itself is skipped).
# Each model has its own free-tier rate limit, so a longer chain = more capacity.
MODEL_FALLBACKS=groq/openai/gpt-oss-120b,gemini/gemini-3.5-flash-lite,groq/openai/gpt-oss-20b,groq/qwen/qwen3.8-27b
# Caps hidden "thinking" on reasoning models so it doesn't eat max_tokens (low / medium / high; empty = off).
REASONING_EFFORT=low
# Faster, cheaper alternative cheap model if Gemini's free tier is slow (held-out eval 7/8 vs 8/8):
# MODEL_FAST=groq/openai/gpt-oss-20b

# "Simulate provider outage" toggle in the UI: calls ask for this model first. It is retired upstream,
# so Gemini genuinely rejects it and Bifrost serves the call from the fallback chain.
DEMO_OUTAGE_MODEL=gemini/gemini-2.5-flash

# 1 = fully offline demo (canned search + LLM). Use for UI work and as a demo backup.
STALEGUARD_MOCK=0

MAX_CLAIMS=10
CONCURRENCY=4
RECHECK_WINDOW_MIN=90
