# Copy to .env and fill in.

# Tavily: https://app.tavily.com (free credits for hackathon participants)
TAVILY_API_KEY=tvly-xxxxxxxx

# Bifrost gateway. Start it with scripts\start-bifrost.ps1, then add provider keys at http://localhost:8080
BIFROST_URL=http://localhost:8080

# Models as provider/model, routed by Bifrost. Use providers you've added keys for in the Bifrost UI.
# Gemini and Groq both have free tiers.
MODEL_FAST=gemini/gemini-2.5-flash
MODEL_SMART=gemini/gemini-2.5-flash
# Bifrost tries these, in order, if the primary provider fails (comma-separated).
MODEL_FALLBACKS=groq/llama-3.3-70b-versatile

# 1 = fully offline demo (canned search + LLM). Use for UI work and as a demo backup.
STALEGUARD_MOCK=0

MAX_CLAIMS=10
CONCURRENCY=4
RECHECK_WINDOW_MIN=90
